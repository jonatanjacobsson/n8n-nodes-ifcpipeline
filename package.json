{
  "name": "n8n-nodes-ifcpipeline",
  "version": "0.7.1",
  "description": "n8n nodes for the object-storage (S3/MinIO) variant of IFC Pipeline. Requires USE_OBJECT_STORAGE=true on the target deployment; legacy filesystem deployments are no longer supported.",
  "keywords": [
    "n8n-community-node-package",
    "ifc",
    "bim",
    "ifcpipeline",
    "ifcopenshell"
  ],
  "license": "MIT",
  "homepage": "https://github.com/jonatanjacobsson/ifcpipeline",
  "author": {
    "name": "IFC Pipeline Contributors",
    "email": "jonatan.jacobsson@byggstyrning.se"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jonatanjacobsson/n8n-nodes-ifcpipeline.git"
  },
  "engines": {
    "node": ">=18.10",
    "pnpm": ">=7.0"
  },
  "packageManager": "pnpm@7.33.6",
  "main": "index.js",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "pnpm build && pnpm lint -c .eslintrc.prepublish.js nodes credentials package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/IfcPipelineApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/IfcPipeline/IfcPipeline.node.js",
      "dist/nodes/Fragments/Fragments.node.js",
      "dist/nodes/IfcConversion/IfcConversion.node.js",
      "dist/nodes/IfcCsv/IfcCsv.node.js",
      "dist/nodes/IfcToJson/IfcToJson.node.js",
      "dist/nodes/IfcClash/IfcClash.node.js",
      "dist/nodes/IfcCoord/IfcCoord.node.js",
      "dist/nodes/IfcTester/IfcTester.node.js",
      "dist/nodes/IfcDiff/IfcDiff.node.js",
      "dist/nodes/IfcQuantityTakeoff/IfcQuantityTakeoff.node.js",
      "dist/nodes/IfcPatch/IfcPatch.node.js",
      "dist/nodes/Ifc2Peppol/Ifc2Peppol.node.js",
      "dist/nodes/TopologicPy/TopologicPy.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/request": "^2.48.13",
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^8.56.0",
    "eslint-plugin-n8n-nodes-base": "1.16.3",
    "gulp": "^4.0.2",
    "n8n-workflow": "^1.82.0",
    "prettier": "^3.3.2",
    "typescript": "^5.5.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "pnpm": {
    "overrides": {
      "form-data": ">=4.0.4",
      "axios": ">=1.15.0",
      "braces": ">=3.0.3",
      "lodash": ">=4.18.0",
      "js-yaml": ">=4.1.1",
      "follow-redirects": ">=1.16.0",
      "micromatch": ">=4.0.8",
      "picomatch": ">=2.3.2",
      "minimatch@3": ">=3.1.4",
      "minimatch@9": ">=9.0.7",
      "brace-expansion@1": ">=1.1.13",
      "brace-expansion@2": ">=2.0.3",
      "flatted": ">=3.4.2"
    }
  },
  "overrides": {
    "form-data": ">=4.0.4",
    "axios": ">=1.15.0",
    "braces": ">=3.0.3",
    "lodash": ">=4.18.0",
    "js-yaml": ">=4.1.1",
    "follow-redirects": ">=1.16.0",
    "micromatch": ">=4.0.8",
    "picomatch": ">=2.3.2",
    "minimatch@3": ">=3.1.4",
    "minimatch@9": ">=9.0.7",
    "brace-expansion@1": ">=1.1.13",
    "brace-expansion@2": ">=2.0.3",
    "flatted": ">=3.4.2"
  }
}
